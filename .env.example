# Case Timeline Agent settings. Copy to .env and edit; every variable is optional.
# All settings use the CT_ prefix (see pipeline/config.py). Relative paths resolve against the
# project root. Nothing here should point at a remote host: case data never leaves the machine.

# --- Case and folders -------------------------------------------------------------------------
# Case id: 1-64 letters, digits, '.', '_' or '-' (it is also used as a folder name).
CT_CASE_ID=demo
# Evidence folder: read-only, never written. Mount it read-only in the sandbox.
CT_EVIDENCE_DIR=./tests/fixtures/case_demo
# Writable data folder: SQLite database, upload inbox (data/inbox), logs, eval reports.
# Must not be inside the evidence folder (the app refuses to start if it is).
CT_DATA_DIR=./data
# Case time zone (IANA name). A time stated in UTC/GMT/Zulu is converted to it before its
# calendar day is taken ("0016 UTC" on July 28 is July 27 in Chicago). Unset = no conversion.
# The NTSB case: CT_CASE_TZ=America/Chicago
# CT_CASE_TZ=
# The case's incident date (YYYY-MM-DD). Unset = the consensus of the documents' own incident
# dates; a document that never states it (an interview weeks later) dates its account by it.
# CT_CASE_INCIDENT_DATE=
# Database path (default: $CT_DATA_DIR/case.db).
# CT_DB_PATH=./data/case.db

# --- Local model (vLLM, OpenAI-compatible) ---------------------------------------------------
# vLLM binds the docker0 bridge so the NemoClaw sandbox can reach it; never 0.0.0.0.
# From a laptop, tunnel instead: ssh -N -L 8000:127.0.0.1:8000 user@gb10-host
# and set CT_LLM_BASE_URL=http://localhost:8000/v1
CT_LLM_BASE_URL=http://172.17.0.1:8000/v1
CT_LLM_MODEL=qwen3.6-35b-a3b
# Seconds per model request.
CT_LLM_TIMEOUT=300
# Most model requests in flight at once (extraction chunks and documents share this limit).
# Keep it at 4 or lower on the shared Qwen3.6 server: it crashes at about 10-16.
# CT_LLM_CONCURRENCY=4
# Extra hosts trusted to be this machine (JSON list); llm.py refuses any other non-loopback host.
# CT_LLM_ALLOWED_HOSTS=["host.openshell.internal","172.17.0.1"]
# Embedding model for semantic search (sentence-transformers, run locally) and its dimension.
CT_EMBED_MODEL=BAAI/bge-m3
CT_EMBED_DIM=1024

# --- App server (web UI + job worker) ---------------------------------------------------------
# Loopback only; reach it through an SSH tunnel: ssh -N -L 8090:127.0.0.1:8090 user@gb10-host
CT_UI_HOST=127.0.0.1
CT_UI_PORT=8090
# Start the job worker inside the app server (it runs every queued scan).
CT_RUN_WORKER=true
# How often the worker checks the job queue, in seconds.
CT_WORKER_POLL_SECONDS=2.0
# Keep at most this many drafts per document, most confident first (0 = no cap).
CT_MAX_DRAFTS_PER_DOC=40
# UI chat: "auto", "openclaw" or "local"; CT_OPENCLAW_AGENT names the OpenClaw agent to ask.
# CT_CHAT_BACKEND=auto
# CT_OPENCLAW_AGENT=

# --- Parsing ------------------------------------------------------------------------------------
# Set to 1 to skip Docling and use the PyMuPDF / plain-text parsers only.
# CT_DISABLE_DOCLING=0

# --- MCP server (stdio, spawned by OpenClaw) ----------------------------------------------------
# Log level for data/mcp.log and stderr (stdout carries JSON-RPC only).
# CT_LOG_LEVEL=INFO

# --- OpenClaw cron (scripts/openclaw_cron.sh) ---------------------------------------------------
# Demo mode has no messaging channel: leave CT_ALERT_CHANNEL unset and alerts stay in the UI.
# If you add one, only content-free alerts are sent (case name, alert type, dashboard link),
# and the sandbox policy must allow that single endpoint.
# CT_ALERT_CHANNEL=telegram
# CT_ALERT_TO=
# CT_SCAN_EVERY=5m
# CT_TZ=America/Los_Angeles
